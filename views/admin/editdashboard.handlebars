<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>


    <main class="container py-5" style="max-width: 750px;">

        <form action="/user/edit/{{id}}" method="POST"  >

            <h2 class="fw-bold mb-4">Edit Dashboard</h2>

            <div class="mb-3">
                <label class="form-label">User Name:</label>
                <input type="text" class="form-control" name="name" 
                    placeholder="Enter user name" required>
            </div>
{{!-- value="{{user.name}}" --}}
            <div class="mb-3">
                <label class="form-label">User Role</label>

                <select name="role" class="form-control" required>
                    <option value="">Select your Role</option>
                    <option name="role" value="admin">Admin</option>
                    <option name="role"  value="user">User</option>

                    {{!-- {{#each categories}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>
                        {{this.category}}
                    </option>
                    {{/each}} --}}
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">User Email:</label>
                <input type="email" class="form-control" name="email" 
                    placeholder="Enter email" required>
                {{!-- <textarea name="email" class="form-control" rows="4">{{product.description}}</textarea> --}}
            </div>


            <button type="submit" class="btn btn-primary btn-lg">
                Update User
            </button>

            <a href=" /admin" class="btn btn-secondary btn-lg">
                Cancel
            </a>

        </form>

    </main>


</body>

</html>