<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Products</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <main style="display: flex; justify-content:center; ">
        <form method="post" action="/createcategory"  class="container">
            <h2 class="fw-bold mb-1">
                Create Category
            </h2>
            <div class="mb-3">
                <label>Product Category:</label>
                <input type="text" name="category" placeholder="Enter your category..." class="form-control">
      
            </div>
              <div class="mb-3">
            <button type="submit" class="btn btn-outline-primary btn-lg">Create Category</button>
            <a href="/admin" class="btn btn-outline-secondary btn-lg">Cancel</a>
        </div>
        </form>
     
        </form>

    </main>
</body>

