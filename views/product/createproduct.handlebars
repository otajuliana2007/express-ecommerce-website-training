<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Products</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <main style="display: flex; justify-content:center; ">
        <form action="/create" enctype="multipart/form-data" class="container" method="post">
            <h2 class="fw-bold mb-1">
                Create Product
            </h2>
            <div class="mb-3">
                <label>Product Name:</label>
                <input type="text" class="form-control" name="product_name" placeholder="Enter product name">
            </div>
            <div class="mb-3">
                <label>Product Category:</label>
                <select name="category_id" id="" class="form-control">
                   <option value="">
                    select your category
                   </option>
                   {{#each categories}}
                   <option value={{id}}>
                    {{category}}
                   </option>
                {{/each}}
                </select>

        </form>
        <div class="mb-3">
            <label>Product Decription:</label>
            <textarea name="description" class="form-control" cols="10" rows="5"></textarea>
        </div>
        <div class="mb-3">
            <label>Selling price:</label>
            <input type="text" name="price" placeholder="Enter price in Naira" class="form-group">
        </div>

        <div class="mb-3">
            <label>Quantity:</label>
            <input type="number" name="quantity"   class="form-group">
        </div>


        <div class="mb-3">
            <label>Display Picture:</label>
            <input type="file" name="image">
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-outline-primary btn-lg">Create Product</button>
            <a href="/admin" class="btn btn-outline-secondary btn-lg">Cancel</a>
        </div>
        </form>

    {{!-- CREATE TABLE products(
        id int(20) AUTO_INCREMENT PRIMARY KEY,
        description varchar(225) NOT NULL,
        price varchar(100) NOT NULL,
        image varchar(225) NOT NUll,
        quantity int(100) NOT NULL DEFAULT 0,
        category_id int(20) NOT NULL,
        FOREIGN KEY (category_id) REFERENCES categories(id) ON DELETE RESTRICT ON UPDATE CASCADE
        
    );
     --}}
    </main>
</body>

</html>