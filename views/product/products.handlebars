 <!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div>
        <div style="display: flex;justify-content:space-around;align-items:center;margin-top:50px">

            <h5 class="mb-0 fw-bold">All Products</h5>
            <a href="/admin" class="btn btn-outline-success btn-sm">+ Back</a>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Product Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Price</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Cover Image</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                {{#each products}}
                <tr>
                    <th scope="row">{{this.id}}</th>
                    <td>{{this.product_name}}</td>
                    <td>{{this.description}}</td>
                    <td>₦{{this.price}}</td>
                    <td>{{this.quantity}}</td>
                    <td><img src="/uploads/products/{{this.image}}" alt="{{this.product_name}}" width="50px"/></td>
                    <td></td>
                    <td></td>
                    <td style="display: flex; gap:20px;">
                        <a href="/product/{{this.id}}/edit" class="btn btn-success">Edit</a>
                        {{!-- <a href="" class="btn btn-danger">Delete</a> --}}

                        <form action="/delete/{{this.id}}" method="post" 
                        onsubmit="Are you sure you want to delete product">
                            <button class="btn btn-danger">Delete</button>
                        </form>

                    </td>
                </tr>
            {{/each}}
            </tbody>
        </table>

    </div>





    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>